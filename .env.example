# ==========================================
# PathPrint Environment Configuration Template
# ==========================================

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Backend Application ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://pathprint.vercel.app

# --- Neo4j AuraDB ---
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# --- AI Inference Providers ---
# Google Gemini Flash (Profile extraction & resume tailoring)
GEMINI_API_KEY=AIzaSy...

# Groq LPU (High speed inference)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# --- GitHub Token (Optional for higher rate limits) ---
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...

# --- Frontend Client Environment Variables ---
VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
